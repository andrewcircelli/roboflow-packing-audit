.venv/
.env
__pycache__/
*.pyc
.DS_Store
out/

# Capture data is never committed. Deny everything under data/ and allow back
# only the placeholder -- an extension allowlist is the wrong shape here, since
# one missed case (.JPG vs .jpg) publishes footage of a real shipping label with
# a home address on it. Deny-by-default is the only safe rule.
data/*
!data/.gitkeep
